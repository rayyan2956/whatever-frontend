NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_VENDOR_APP_URL=http://localhost:3002
# Google OAuth web client ID. Leave empty to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Error reporting. Leave empty to turn Sentry off (local development).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Build/deploy only: uploads source maps when set.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
